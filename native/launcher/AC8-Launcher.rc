// Icon, manifest and version information of AC8 Integrated.exe. launcher-version.h is generated from version.json.
#include <windows.h>
#include "launcher-version.h"

1 ICON "..\\..\\package-template\\app\\AC8.ico"
1 RT_MANIFEST "AC8-Launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AC8_VERSION_NUM
 PRODUCTVERSION AC8_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "CreeperUX"
   VALUE "FileDescription", "AC8 Integrated"
   VALUE "FileVersion", AC8_VERSION_STR
   VALUE "InternalName", "AC8-Launcher"
   VALUE "OriginalFilename", "AC8 Integrated.exe"
   VALUE "ProductName", "AC8 Integrated"
   VALUE "ProductVersion", AC8_VERSION_STR
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
